<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.defaultDescription }}">
  <title>{{ title or site.defaultTitle }}</title>
  <link rel="canonical" href="{{ site.baseUrl }}{{ canonicalPath }}">
  <meta property="og:locale" content="cs_CZ">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.defaultTitle }}">
  <meta property="og:description" content="{{ description or site.defaultDescription }}">
  <meta property="og:url" content="{{ site.baseUrl }}{{ canonicalPath }}">
  <meta property="og:image" content="{{ site.baseUrl }}{{ site.socialImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon-48.png" sizes="48x48" type="image/png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" sizes="180x180">
  <link rel="manifest" href="/assets/site.webmanifest">
  <link rel="stylesheet" href="/styles.css?v=20260718-cms">
  <script src="/script.js?v=20260718-cms" defer></script>
  <!-- MailerLite Universal -->
  <script>
      (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
      .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
      n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
      (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
      ml('account', '{{ site.mailerLiteAccount }}');
  </script>
  <!-- End MailerLite Universal -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.baseUrl }}",
    "logo": "{{ site.baseUrl }}{{ site.logo }}",
    "sameAs": ["{{ site.facebook }}", "{{ site.instagram }}"]
  }
  </script>
</head>
<body{% if newsletterAuto %} data-newsletter-auto{% endif %}>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/index.html" aria-label="Starostové Praha 13 – úvod">
        <img class="brand-logo" src="{{ site.logo }}" alt="{{ site.logoAlt }}">
      </a>
      <button class="menu-toggle" type="button" aria-label="Otevřít menu" aria-expanded="false" aria-controls="main-navigation"><span></span></button>
      <nav class="site-nav" id="main-navigation" aria-label="Hlavní navigace">
        <a href="/index.html"{% if navKey == "home" %} aria-current="page"{% endif %}>Domů</a>
        <a href="/tym.html"{% if navKey == "team" %} aria-current="page"{% endif %}>Náš tým</a>
        <a href="/program.html"{% if navKey == "program" %} aria-current="page"{% endif %}>Náš program</a>
        <a href="/aktuality.html"{% if navKey == "news" %} aria-current="page"{% endif %}>Aktuality</a>
        <a href="/kontakt.html"{% if navKey == "contact" %} aria-current="page"{% endif %}>Kontakt</a>
        <div class="nav-socials" role="group" aria-label="Sociální sítě">
          <a class="nav-social" href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Facebook Starostové Praha 13">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.4 8.4V6.5c0-.9.6-1.1 1-1.1H18V1.2L14.4 1C10.5 1 9.6 4 9.6 6v2.4H7v4.7h2.6V23h4.8v-9.9h3.2l.4-4.7h-3.6Z"/></svg>
          </a>
          <a class="nav-social" href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="Instagram Starostové Praha 13">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle class="social-dot" cx="17.6" cy="6.5" r="1.15"/></svg>
          </a>
        </div>
        <a class="nav-join" href="/zapojte-se.html"{% if navKey == "join" %} aria-current="page"{% endif %}>Přidej se</a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <button class="newsletter-trigger ml-onclick-form" type="button" onclick="ml('show', '{{ site.mailerLiteForm }}', true)" aria-label="Odebírat novinky e-mailem">Odebírat novinky</button>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a class="brand footer-brand" href="/index.html"><img class="brand-logo" src="{{ site.logo }}" alt="{{ site.logoAlt }}"></a>
          <p>{{ site.footerText }}</p>
        </div>
        <nav class="footer-links" aria-label="Odkazy v zápatí">
          <a href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a>
          <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>
          <a href="{{ site.stan }}" target="_blank" rel="noopener">STAN</a>
        </nav>
      </div>
      <div class="footer-bottom"><span>{{ site.copyright }}</span><span>{{ site.cookieText }}</span></div>
    </div>
  </footer>
</body>
</html>
