layout: base.njk
permalink: tym.html
canonicalPath: /tym.html
title: Náš tým | STAN Praha 13
description: Tým Starostů a nezávislých pro Prahu 13.
navKey: team
---
{% set visibleCandidates = candidates | visible %}
<section class="page-hero team-title-hero">
  <div class="container">
    <h1>Naši zastupitelé za Prahu 13</h1>
    <p>Na Třináctce žijeme a do práce na radnici přinášíme zkušenosti z práva, zdravotnictví, sociálních služeb, neziskového sektoru i rozvoje města. V našich profilech se dozvíte, čemu se každý z nás věnuje a na čem nám v Praze 13 záleží.</p>
  </div>
</section>

<section class="page-main team-page-main">
  <div class="container page-panel">
    <div class="candidate-stack">
      {% for candidate in visibleCandidates %}
      {% if candidate.featured %}
      <article class="candidate-profile reveal" aria-labelledby="team-member-{{ candidate.number }}">
        <div class="candidate-portrait-zone candidate-color-{{ candidate.color }}">
          <img class="candidate-cutout" src="{{ candidate.image }}" alt="{{ candidate.name }}">
        </div>
        <div class="candidate-copy">
          <h2 id="team-member-{{ candidate.number }}">{{ candidate.name }}</h2>
          {% if candidate.functions and candidate.functions.length %}
          <ul class="candidate-functions" aria-label="Funkce v samosprávě">
            {% for function in candidate.functions %}
            <li class="candidate-function">{{ function | escape }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          <p class="candidate-annotation">{{ candidate.annotation }}</p>
        </div>
      </article>
      {% endif %}
      {% endfor %}
    </div>

  </div>
</section>
