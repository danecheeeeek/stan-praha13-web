<section class="page-hero">
  <div class="container">
    <h1>Buďte u toho s námi</h1>
    <p>Naše členská základna se postupně rozšiřuje, protože lidem záleží na lepší Třináctce. Ať už se rozhodnete stát registrovaným příznivcem STAN, nebo pošlete podnět k našemu programu, budeme rádi za každou pomoc. Moc se na vás těšíme!</p>
  </div>
</section>

<section class="page-main">
  <div class="container page-panel">
    <div class="join-grid">
      {% for item in join | visible %}
      <article class="join-card join-card-{{ item.style }} reveal">
        <div class="join-card__content">
          <h2>{{ item.title }}</h2>
          <p>{{ item.text }}</p>
          <div class="join-actions">
            {% for action in item.actions %}
            <a class="card-link{% if loop.first %} card-link--stretched{% endif %}" href="{{ action.url }}"{% if action.external %} target="_blank" rel="noopener"{% endif %}>
              <span class="button">{{ action.label }}</span>
            </a>
            {% endfor %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
