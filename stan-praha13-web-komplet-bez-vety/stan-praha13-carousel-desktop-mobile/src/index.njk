---
layout: base.njk
permalink: index.html
canonicalPath: /
title: STAN Praha 13 | Nová energie pro Třináctku
description: Starostové a nezávislí Praha 13. Nová energie pro Třináctku.
navKey: home
newsletterAuto: true
---
{% set slides = carousel | visible %}
<section class="hero-shell" aria-label="Hlavní témata">
  <div class="container hero-slider" data-hero-slider aria-roledescription="carousel">
    <div class="hero-slides" aria-live="polite">
      {% for slide in slides %}
      <article class="hero-slide{% if loop.first %} is-active{% endif %}{% if slide.layout == 'event' %} hero-slide-event{% endif %}" data-hero-slide aria-label="{{ loop.index }} ze {{ slides.length }}"{% if not loop.first %} aria-hidden="true" inert{% endif %}>
        {% if slide.layout == "home" %}
        <div class="hero hero-home">
          <div class="hero-copy">
            <h1>{{ slide.title }}</h1>
            <p>{{ slide.text }}</p>
            {% if slide.actions.length %}
            <div class="actions">
              {% for action in slide.actions %}
              <a class="button{% if action.style == 'outline' %} button-outline{% endif %}" href="{{ action.url }}"{% if action.external %} target="_blank" rel="noopener"{% endif %}>{{ action.label }}</a>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          <div class="hero-visual hero-team-visual">
            <picture>
              {% if slide.mobileImage %}<source media="(max-width: 760px)" srcset="{{ slide.mobileImage }}">{% endif %}
              <img class="hero-team-photo" src="{{ slide.image }}" alt="{{ slide.imageAlt }}">
            </picture>
          </div>
        </div>
        {% else %}
        <div class="hero hero-event">
          <div class="hero-visual hero-event-visual" role="img" aria-label="{{ slide.imageAlt }}" style="--hero-image: url('{{ slide.image }}');{% if slide.mobileImage %} --hero-image-mobile: url('{{ slide.mobileImage }}');{% endif %}"></div>
          <div class="hero-copy event-slide-copy">
            <h2>{{ slide.title }}</h2>
            <p>{{ slide.text }}</p>
            {% for action in slide.actions %}
            <a class="button{% if action.style == 'outline' %} button-outline{% endif %}" href="{{ action.url }}"{% if action.external %} target="_blank" rel="noopener"{% endif %}>{{ action.label }}</a>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </article>
      {% endfor %}
    </div>

    {% if slides.length > 1 %}
    <button class="slider-arrow slider-prev" type="button" data-slider-prev aria-label="Předchozí okno"><span aria-hidden="true">←</span></button>
    <button class="slider-arrow slider-next" type="button" data-slider-next aria-label="Další okno"><span aria-hidden="true">→</span></button>
    <div class="slider-dots" role="group" aria-label="Výběr okna">
      {% for slide in slides %}
      <button class="slider-dot{% if loop.first %} is-active{% endif %}" type="button" data-slider-dot="{{ loop.index0 }}" aria-label="Zobrazit okno {{ loop.index }}"{% if loop.first %} aria-current="true"{% endif %}></button>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<section class="content-wrap">
  <div class="container">
    <div class="home-panel reveal">
      <div class="home-grid">
        {% for card in homeCards | visible %}
        <article class="feature-card">
          <div class="feature-art{% if card.artClass %} {{ card.artClass }}{% endif %}">
            <img src="{{ card.image }}" alt="{{ card.imageAlt }}">
          </div>
          <h2>{{ card.title }}</h2>
          <p>{{ card.text }}</p>
          <a class="button" href="{{ card.buttonUrl }}">{{ card.buttonLabel }}</a>
        </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
